{
  "name": "pizza-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Track, rate, and take notes on every pizza place you visit.",
  "scripts": {
    "postinstall": "npm --prefix client install",
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "set-password": "node --env-file-if-exists=.env scripts/set-password.mjs",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "express": "^5.1.0"
  }
}
