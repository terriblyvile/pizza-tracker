# Copy this file to `.env` and fill it in. Everything here is read only by the
# server process — none of it reaches the browser.

# Switches search from the built-in demo list to live Google Places results.
# Setup: see the "Connecting Google Places" section of README.md
GOOGLE_MAPS_API_KEY=

# Port the API + built app are served on. Defaults to 3001.
PORT=3001

# Login password, stored as a scrypt hash. Never write a plaintext password
# here — generate the hash with:
#   npm run set-password    (writes this file for you)
#   npm run hash-password   (prints the hash; use this with Docker)
# Fields are ':'-separated rather than '$' so docker-compose doesn't try to
# interpolate parts of it.
AUTH_PASSWORD_HASH=

# Interface to bind to when running WITHOUT Docker (npm start). Defaults to
# 127.0.0.1 so the app is only reachable from this machine.
# HOST=0.0.0.0

# --- Docker only -----------------------------------------------------------
# Which address on the HOST the container's port is published to. Defaults to
# 127.0.0.1, i.e. the server itself only.
#
# Set 0.0.0.0 to reach it from other machines on your network. That traffic is
# unencrypted: your password and session cookie cross the network in the clear,
# so only do it on a network you trust, and prefer an SSH tunnel or a TLS
# reverse proxy. See "Reaching it from another machine" in README.md.
# BIND_ADDRESS=0.0.0.0

# Port on the host, if 3001 is already taken there.
# HOST_PORT=3001

# Set when running behind a reverse proxy (nginx, Caddy, Cloudflare Tunnel) so
# client IPs and HTTPS detection are read from X-Forwarded-* headers.
# TRUST_PROXY=1
